# Public URL of this board (without trailing slash)
BASE_URL=https://board.example.com

# Public URL of the Gitea instance
GITEA_URL=https://git.example.com
# Optional: internal URL for server-to-server calls (e.g. on the same Docker network)
# GITEA_INTERNAL_URL=http://gitea:3000

# OAuth2 application from Gitea (Settings -> Applications -> OAuth2 Applications)
# Redirect URI: ${BASE_URL}/auth/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Optional
# PORT=3000
# CLOSED_ISSUES_LIMIT=100
# SESSION_MAX_AGE_DAYS=7
# OAUTH_SCOPES="read:user read:organization read:repository write:issue"
